# Target Google Sheet ID (Found in your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Google Service Account Credentials:
# Option A: Path to credentials JSON file (e.g., credentials.json)
# Option B: Raw JSON string of the service account key
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json

# Server Configuration
PORT=8000
HOST=0.0.0.0
